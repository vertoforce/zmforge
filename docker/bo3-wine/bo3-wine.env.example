# Copy to bo3-wine.env and set the one path below. Read by setup.sh, check.sh,
# scripts/wine-tool.sh and scripts/wine-bake.sh. bo3-wine.env is gitignored:
# it names a path on your machine and nothing else.

# Your own Black Ops III mod tools install (Steam app 455130). The folder that
# contains bin/, share/ and map_source/. Its name ends in "455130".
#
# On a Linux box with Steam:
#   ZMFORGE_WINE_TOOLS="$HOME/.steam/steam/steamapps/common/Call of Duty Black Ops III 455130"
# On a copy taken off a Windows machine, wherever you put it:
#   ZMFORGE_WINE_TOOLS=/path/to/bo3-mod-tools
ZMFORGE_WINE_TOOLS=

# Where the Wine prefix, the patched ray tracer and Radiant's converted-asset
# cache are written. Defaults to ./wineprefix next to this file. It reaches
# about 1.5 GB. Do not put it inside the tools install.
#ZMFORGE_WINE_PREFIX=/var/lib/bo3-wine/prefix

# The image tag setup.sh builds and the scripts run.
#BO3_WINE_IMAGE=bo3-wine:local
